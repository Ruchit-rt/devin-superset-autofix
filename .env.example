# ── Devin API ───────────────────────────────────────────────────────────────
DEVIN_API_KEY=your_service_user_api_key
DEVIN_ORG_ID=org-xxxxxxxxxxxx
DEVIN_BASE_URL=https://api.devin.ai/v3
# Created by scripts/setup_playbook.py (leave blank until then):
DEVIN_PLAYBOOK_ID=
DEVIN_KNOWLEDGE_IDS=
DEVIN_MODE=normal
MAX_ACU_LIMIT=10

# ── GitHub ──────────────────────────────────────────────────────────────────
# A PAT with `repo` scope on the fork (used to file issues + read them).
GITHUB_TOKEN=ghp_xxx
TARGET_REPO=Ruchit-rt/superset
# Shared secret you also paste into the GitHub repo webhook settings.
# Leave BLANK in DRY_RUN so the sample webhook curl works without signing; set a real
# value for a live run (signatures are then verified).
WEBHOOK_SECRET=
LABEL=devin-auto-fix
SECURITY_LABEL=security

# ── Behaviour ───────────────────────────────────────────────────────────────
# DRY_RUN=true => no Devin/GitHub calls; sessions + issues are simulated locally.
DRY_RUN=true
# AUTO_LABEL=true => scan.py applies the trigger label itself (zero-touch).
AUTO_LABEL=false
POLL_INTERVAL=20
SCAN_INTERVAL_HOURS=24
ENABLE_ISSUE_POLLING=true
ENABLE_SCAN_SCHEDULER=false
# How long a simulated Devin session "works" before it reports a fixed PR:
SIM_DURATION_SECONDS=30
# Manual engineering hours each completed remediation replaces (drives the
# "Engineer-hrs saved" productivity tile on the dashboard).
HOURS_SAVED_PER_FIX=3

# ── Scanning ────────────────────────────────────────────────────────────────
# Local checkout of the target repo (defaults to the superset fork two levels up).
SUPERSET_REPO_PATH=../..
SCAN_LOCKFILES=requirements/base.txt,requirements/development.txt
